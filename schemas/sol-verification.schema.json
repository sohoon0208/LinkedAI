{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedai.local/schemas/sol-verification.schema.json",
  "title": "LinkedAI SOL Verification",
  "description": "Canonical final verification artifact. Only SOL may authorize DONE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "plan_id",
    "agent_id",
    "authority",
    "state",
    "criteria",
    "decisive_evidence",
    "remaining_problem",
    "next_open_question",
    "next_scope",
    "evidence_requests",
    "attempts",
    "limits"
  ],
  "properties": {
    "run_id": {
      "$ref": "#/$defs/meaningfulString"
    },
    "plan_id": {
      "$ref": "#/$defs/meaningfulString"
    },
    "agent_id": {
      "$ref": "#/$defs/meaningfulString"
    },
    "authority": {
      "const": "SOL"
    },
    "state": {
      "enum": [
        "DONE",
        "RETRY",
        "REPLAN",
        "EVIDENCE",
        "BLOCKED"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterionEvidence"
      }
    },
    "decisive_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meaningfulString"
      }
    },
    "remaining_problem": {
      "type": "string"
    },
    "next_open_question": {
      "type": "string"
    },
    "next_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meaningfulString"
      }
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRequest"
      }
    },
    "attempts": {
      "$ref": "#/$defs/counters"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["state"],
        "properties": {"state": {"const": "DONE"}}
      },
      "then": {
        "properties": {
          "criteria": {
            "minItems": 1,
            "items": {"properties": {"status": {"const": "PASS"}}}
          },
          "decisive_evidence": {"minItems": 1},
          "remaining_problem": {"const": ""},
          "next_open_question": {"const": ""},
          "next_scope": {"maxItems": 0},
          "evidence_requests": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "required": ["state"],
        "properties": {"state": {"const": "EVIDENCE"}}
      },
      "then": {
        "properties": {"evidence_requests": {"minItems": 1}}
      }
    },
    {
      "if": {
        "required": ["state"],
        "properties": {
          "state": {"enum": ["RETRY", "REPLAN", "EVIDENCE", "BLOCKED"]}
        }
      },
      "then": {
        "properties": {
          "remaining_problem": {"pattern": "\\S"},
          "next_open_question": {"pattern": "\\S"},
          "next_scope": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "meaningfulString": {
      "type": "string",
      "pattern": "\\S"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "criterionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[1-9][0-9]*$"
        },
        "status": {
          "enum": ["PASS", "FAIL", "UNPROVEN"]
        },
        "evidence": {
          "$ref": "#/$defs/meaningfulString"
        }
      }
    },
    "evidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/meaningfulString"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/meaningfulString"}
        },
        "reason": {"$ref": "#/$defs/meaningfulString"}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sol_verifications", "luna_attempts", "astra_plans"],
      "properties": {
        "sol_verifications": {"$ref": "#/$defs/nonnegativeInteger"},
        "luna_attempts": {"$ref": "#/$defs/nonnegativeInteger"},
        "astra_plans": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_sol_verifications", "max_luna_attempts", "max_astra_plans"],
      "properties": {
        "max_sol_verifications": {"$ref": "#/$defs/positiveInteger"},
        "max_luna_attempts": {"$ref": "#/$defs/positiveInteger"},
        "max_astra_plans": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "paths", "revision"],
      "properties": {
        "kind": {"enum": ["git", "scoped"]},
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/meaningfulString"}
        },
        "revision": {"$ref": "#/$defs/meaningfulString"}
      }
    }
  }
}
