{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkedai.local/echo-mode/schemas/luna-verification.schema.json",
  "title": "LinkedAI Echo Mode LUNA Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "plan_id", "agent_id", "authority", "state", "criteria", "decisive_evidence", "remaining_problem", "next_open_question", "next_scope", "evidence_requests", "attempts", "limits", "snapshot"],
  "properties": {
    "run_id": {"type": "string", "pattern": "\\S"},
    "plan_id": {"type": "string", "pattern": "\\S"},
    "agent_id": {"type": "string", "pattern": "\\S"},
    "authority": {"const": "LUNA"},
    "state": {"enum": ["DONE", "RETRY", "REPLAN", "EVIDENCE", "BLOCKED"]},
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "decisive_evidence": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "remaining_problem": {"type": "string"},
    "next_open_question": {"type": "string"},
    "next_scope": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "evidence_requests": {"type": "array", "items": {"$ref": "#/$defs/evidenceRequest"}},
    "attempts": {"$ref": "#/$defs/counters"},
    "limits": {"$ref": "#/$defs/limits"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "allOf": [
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "DONE"}}},
      "then": {
        "properties": {
          "criteria": {"minItems": 1, "items": {"properties": {"status": {"const": "PASS"}}}},
          "decisive_evidence": {"minItems": 1},
          "remaining_problem": {"const": ""},
          "next_open_question": {"const": ""},
          "next_scope": {"maxItems": 0},
          "evidence_requests": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "EVIDENCE"}}},
      "then": {"properties": {"evidence_requests": {"minItems": 1}}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"enum": ["RETRY", "REPLAN", "EVIDENCE", "BLOCKED"]}}},
      "then": {"properties": {"remaining_problem": {"pattern": "\\S"}, "next_open_question": {"pattern": "\\S"}, "next_scope": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"},
        "status": {"enum": ["PASS", "FAIL", "UNPROVEN"]},
        "evidence": {"type": "string", "pattern": "\\S"}
      }
    },
    "evidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
        "reason": {"type": "string", "pattern": "\\S"}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["luna_verifications", "luna_attempts", "astra_plans"],
      "properties": {
        "luna_verifications": {"type": "integer", "minimum": 0},
        "luna_attempts": {"type": "integer", "minimum": 0},
        "astra_plans": {"type": "integer", "minimum": 0}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_luna_verifications", "max_luna_attempts", "max_astra_plans"],
      "properties": {
        "max_luna_verifications": {"type": "integer", "minimum": 1},
        "max_luna_attempts": {"type": "integer", "minimum": 1},
        "max_astra_plans": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "paths", "revision"],
      "properties": {
        "kind": {"enum": ["git", "scoped"]},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "revision": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
